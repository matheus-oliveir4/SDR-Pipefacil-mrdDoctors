# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
APP_VERSION=0.1.0

# Universal non-secret agent defaults live in .agent.json.

# Recommended environment mapping:
# - local dev: APP_ENV=development
# - homolog/staging: APP_ENV=staging
# - production: APP_ENV=production

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# -----------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_URL=http://127.0.0.1:8000
CLOUDFLARE_TUNNEL_METRICS=127.0.0.1:0
CLOUDFLARE_TUNNEL_LOGLEVEL=info
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Optional: set DATABASE_URL to enable Postgres-backed checkpoints.
DATABASE_URL=
LANGGRAPH_CHECKPOINT_SCHEMA=
# Optional pool tuning for the LangGraph Postgres checkpointer.
# LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
# LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=10
# LANGGRAPH_CHECKPOINT_POOL_TIMEOUT_SECONDS=10
# DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres
# LANGGRAPH_CHECKPOINT_SCHEMA=sdr_cliente

# -----------------------------------------------------------------------------
# Pipefacil
# -----------------------------------------------------------------------------
# Pipefacil still exposes its public API through this legacy infrastructure hostname.
PIPEFACIL_BASE_URL=https://pipefacil-server.matchsales.com.br
# Required when APP_ENV=production.
PIPEFACIL_API_KEY=your_pipefacil_api_key_here
PIPEFACIL_WEBHOOK_SIGNATURE_ENABLED=true
# Required when APP_ENV=production. Production also requires signature validation enabled.
PIPEFACIL_WEBHOOK_SIGNATURE_SECRET=your_pipefacil_webhook_signature_secret_here
PIPEFACIL_WEBHOOK_SIGNATURE_HEADER=X-Pipefacil-Signature-256
OUTBOUND_MEDIA_CATALOG_PATH=

# -----------------------------------------------------------------------------
# Generated outbound audio / ElevenLabs
# -----------------------------------------------------------------------------
# Enables dynamic audio replies. Requires a public HTTPS URL that Pipefacil/WhatsApp
# can fetch, plus an ElevenLabs API key and voice ID.
GENERATED_AUDIO_ENABLED=false
# Optional legacy fallback. Keep false so the agent chooses text, audio, or both by content.
GENERATED_AUDIO_AUTO_ENABLED=false
# Optional: when empty, CLOUDFLARE_TUNNEL_HOSTNAME is used as https://<hostname>.
GENERATED_AUDIO_PUBLIC_BASE_URL=
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# -----------------------------------------------------------------------------
# Observability / Langfuse
# -----------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_PROMPT_LABEL=staging
LANGFUSE_DEBUG=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional: json or text. Defaults to text outside production and json in production.
# LOG_FORMAT=
# Logs validated inbound webhook payloads with sensitive media fields sanitized.
# Keep false by default.
LOG_INBOUND_PAYLOADS=false

# -----------------------------------------------------------------------------
# LLM / OpenAI
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.3-chat-latest
OPENAI_SPECIALISTS_ENABLED=false
# Optional: when empty, specialists use OPENAI_MODEL.
OPENAI_SPECIALIST_MODEL=
OPENAI_API_KEY=your_openai_api_key_here
