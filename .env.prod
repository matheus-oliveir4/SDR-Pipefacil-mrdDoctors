# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=production
APP_VERSION=0.1.0

# Universal non-secret agent defaults live in .agent.json.

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------
# Optional: set DATABASE_URL to enable Postgres-backed checkpoints in production.
DATABASE_URL=
LANGGRAPH_CHECKPOINT_SCHEMA=
# Optional pool tuning for the LangGraph Postgres checkpointer.
# LANGGRAPH_CHECKPOINT_POOL_MIN_SIZE=1
# LANGGRAPH_CHECKPOINT_POOL_MAX_SIZE=10
# LANGGRAPH_CHECKPOINT_POOL_TIMEOUT_SECONDS=10
# DATABASE_URL=postgresql://user:password@db.example.com:5432/postgres
# LANGGRAPH_CHECKPOINT_SCHEMA=sdr_cliente

# -----------------------------------------------------------------------------
# Cloudflare Tunnel
# -----------------------------------------------------------------------------
# Normally unused in production unless a deploy explicitly runs cloudflared.
# CLOUDFLARE_TUNNEL_HOSTNAME=
# CLOUDFLARE_TUNNEL_URL=
# CLOUDFLARE_TUNNEL_METRICS=
# CLOUDFLARE_TUNNEL_LOGLEVEL=
# CLOUDFLARE_TUNNEL_TOKEN=

# -----------------------------------------------------------------------------
# Pipefacil
# -----------------------------------------------------------------------------
# Pipefacil still exposes its public API through this legacy infrastructure hostname.
PIPEFACIL_BASE_URL=https://pipefacil-server.matchsales.com.br
# Required when APP_ENV=production. The app fails on startup without it.
# PIPEFACIL_API_KEY=
PIPEFACIL_WEBHOOK_SIGNATURE_ENABLED=true
# Required when APP_ENV=production. The app fails on startup without it.
# PIPEFACIL_WEBHOOK_SIGNATURE_SECRET=
PIPEFACIL_WEBHOOK_SIGNATURE_HEADER=X-Pipefacil-Signature-256
OUTBOUND_MEDIA_CATALOG_PATH=

# -----------------------------------------------------------------------------
# Generated outbound audio / ElevenLabs
# -----------------------------------------------------------------------------
GENERATED_AUDIO_ENABLED=false
GENERATED_AUDIO_AUTO_ENABLED=false
# Required when GENERATED_AUDIO_ENABLED=true unless CLOUDFLARE_TUNNEL_HOSTNAME is set.
# GENERATED_AUDIO_PUBLIC_BASE_URL=
# Required when GENERATED_AUDIO_ENABLED=true.
# ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# Observability / Langfuse
# -----------------------------------------------------------------------------
LANGFUSE_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_PROMPT_LABEL=production
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_DEBUG=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Defaults to json when APP_ENV=production.
# LOG_FORMAT=json
LOG_INBOUND_PAYLOADS=false

# -----------------------------------------------------------------------------
# LLM / OpenAI
# -----------------------------------------------------------------------------
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SPECIALISTS_ENABLED=false
# OPENAI_SPECIALIST_MODEL=
# OPENAI_API_KEY=
